# Backend database connection (use a managed MySQL database in production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=rail_sathi
DB_PASSWORD=change-me
DB_NAME=dadar_station_navigation

# Public URL of the deployed chatbot service; Docker Compose uses its internal URL.
CHATBOT_URL=http://localhost:8001
CHATBOT_TIMEOUT_MS=15000

# Comma-separated frontend origin(s); set the exact deployed frontend URL in production.
CORS_ORIGIN=http://localhost:5173

# CHAT_BOT only
MISTRAL_API_KEY=replace-with-a-secret
MISTRAL_MODEL=mistral-small-latest
ENABLE_DOCS=false
