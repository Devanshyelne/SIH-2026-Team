# Backend authentication and MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/setu?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins when frontend and backend are on different domains.
# Docker Compose uses same-origin /api requests, so this can remain unset locally.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Existing MySQL-backed station data
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=station_navigation
DB_PORT=3306
